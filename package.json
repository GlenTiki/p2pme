{
  "name": "@glentiki/p2pme",
  "version": "0.1.1",
  "description": "Hypercore agent peers, approved local sessions, and reactive browser controls.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run --exclude tests/package-smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build": "npm run build:sdk && npm run build:web",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:package",
    "example:native": "npm run build:sdk && node examples/native-peers.mjs",
    "build:web": "node scripts/build-web.mjs",
    "test:package": "vitest run tests/package-smoke.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "hypercore": "11.38.0",
    "hyperdht": "6.34.1",
    "hyperswarm": "4.17.2",
    "trystero": "0.26.0",
    "werift": "0.25.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@trystero-p2p/ws-relay": "0.26.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "playwright": "1.61.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "author": "Glen Keane (https://glentiki.dev)",
  "homepage": "https://p2pme.glentiki.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GlenTiki/p2pme.git"
  },
  "bugs": {
    "url": "https://github.com/GlenTiki/p2pme/issues"
  },
  "keywords": [
    "hypercore",
    "p2p",
    "agents",
    "webrtc",
    "codex",
    "claude"
  ],
  "types": "./dist/index.d.ts",
  "bin": {
    "p2pme": "./dist/cli.js"
  }
}
